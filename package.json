{
  "name": "electron-start",
  "version": "1.0.0",
  "description": "A minimal Electron application",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "gypfile": true,
  "build": {
    "appId": "com.tools.shuanglong",
    "win": {
      "icon": "res/AppIcon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "repository": "https://github.com/xautshuanglong/electron-start",
  "keywords": [
    "Electron",
    "Demo"
  ],
  "author": "Shuanglong",
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "bindings": "^1.5.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "nan": "^2.22.0",
    "node-addon-api": "^8.3.0"
  },
  "dependencies": {
    "electron-log": "^5.1.6"
  }
}
